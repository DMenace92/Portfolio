# Server
PORT=9000

# JWT secret used to sign/verify admin login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_secret_api_key
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_PROJECT_COLLECTION_ID=your_projects_collection_id
APPWRITE_USER_COLLECTION_ID=your_users_collection_id
# Appwrite Storage bucket used for project images
APPWRITE_BUCKET_ID=your_bucket_id

# Frontend (Portfolio/.env) — the API base URL the React app calls
# REACT_APP_API_URL=http://localhost:9000
